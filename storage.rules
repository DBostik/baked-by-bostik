rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Signed-in admin: full access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Customer inspiration uploads on the public order form.
    // Anonymous create only for small images — no public read/update/delete.
    match /requests/{requestId}/{fileName} {
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read, update, delete: if request.auth != null;
    }

    // Quotes (Generated PDFs) — customers open via link
    match /quotes/{fileName} {
      allow read: if true;
    }

    // Gallery Images - Public read, Admin write
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site Content Images - Public read, Admin write
    match /site_content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
