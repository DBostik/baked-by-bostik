rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin logins (keep in sync with firestore.rules). Add a UID to give another login admin access.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'LYJpCo6DEIO9w9Yurupuw0uyxpJ2'   // shared Baked By Bostik admin login
        ];
    }
    // Price-check / receipt bot (keep in sync with firestore.rules). It may only read receipt photos.
    function isPricebot() {
      return request.auth != null && request.auth.uid == 'USNXR3iZcdVnNUY2VdPdoeYE3BI2';
    }

    // Admin: full access to everything (including listing folders)
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Receipts uploaded from the admin's Price Reviews screen (Costing, Phase 4). Admin writes, the bot reads.
    match /receipts/{fileName} {
      allow read: if isAdmin() || isPricebot();
      allow write: if isAdmin();
    }

    // Customer inspiration uploads on the public order form (js/order-flow.js).
    // Anonymous customers may only CREATE photo files under 15 MB in a folder named after a
    // well-formed request id, at a path nothing exists at yet; no anonymous overwrite, update or delete.
    // `get` (not `read`) stays public on purpose: the form calls getDownloadURL() right after
    // uploadBytes(), which needs to fetch that one object. Listing a request's folder is admin only,
    // so nobody can enumerate customer photos by guessing request ids (audit fix, Sep 2026).
    match /requests/{requestId}/{fileName} {
      allow create: if resource == null
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif|avif)')
                    && requestId.matches('[0-9]{8}-[0-9]{4}')
                    && fileName.size() <= 500;
      allow get: if true;
      allow update, delete: if isAdmin();
    }

    // Quotes (generated PDFs): customers open them from the emailed link. One file at a time,
    // never a listing of every quote (audit fix, Sep 2026).
    match /quotes/{fileName} {
      allow get: if true;
    }

    // Gallery images: public read, admin write
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site content images: public read, admin write
    match /site_content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
