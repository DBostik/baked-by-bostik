        <!-- NEW REQUEST MODAL -->
        <div id="new-request-modal" class="modal hidden">
            <div class="modal-backdrop"></div>
            <div class="modal-content" style="max-width: 500px;">
                <div class="modal-header">
                    <h2>New Request</h2>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <form id="new-request-form">
                        <div class="form-group" style="margin-bottom:1rem;">
                            <label for="new-req-customer"
                                style="display:block; margin-bottom:0.5rem; font-weight:500;">Customer</label>
                            <select id="new-req-customer" required
                                style="width:100%; padding:0.5rem; border:1px solid #e5e7eb; border-radius:4px;">
                                <option value="">Select a Customer...</option>
                                <!-- Populated by JS -->
                            </select>
                        </div>

                        <div class="form-group" style="margin-bottom:1rem;">
                            <label for="new-req-date"
                                style="display:block; margin-bottom:0.5rem; font-weight:500;">Event Date</label>
                            <input type="date" id="new-req-date" required
                                style="width:100%; padding:0.5rem; border:1px solid #e5e7eb; border-radius:4px;">
                        </div>

                        <div class="form-group" style="margin-bottom:1rem;">
                            <label for="new-req-type"
                                style="display:block; margin-bottom:0.5rem; font-weight:500;">Type</label>
                            <select id="new-req-type" required
                                style="width:100%; padding:0.5rem; border:1px solid #e5e7eb; border-radius:4px;">
                                <option value="Custom Cake">Custom Cake</option>
                                <option value="Cupcakes">Cupcakes</option>
                                <option value="Cookies">Cookies</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group" style="margin-bottom:1rem;">
                            <label for="new-req-notes"
                                style="display:block; margin-bottom:0.5rem; font-weight:500;">Notes (Optional)</label>
                            <textarea id="new-req-notes" rows="3"
                                style="width:100%; padding:0.5rem; border:1px solid #e5e7eb; border-radius:4px;"></textarea>
                        </div>

                        <button type="submit" class="btn-primary" style="width:100%;">Create Request</button>
                    </form>
                </div>
            </div>
        </div>
