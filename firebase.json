{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "hosting": {
        "public": ".",
        "cleanUrls": true,
        "trailingSlash": true,
        "headers": [
            {
                "source": "/admin/**",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" },
                    { "key": "X-Frame-Options", "value": "DENY" },
                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
                ]
            },
            {
                "source": "**",
                "headers": [
                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
                ]
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            ".agent/**",
            ".github/**",
            "**/node_modules/**",
            "functions/**",
            "src/**",
            "tools/**",
            "docs/**",
            "scripts/**",
            "Claude outputs/**",
            "assets/images/Gallery/**",
            "**/*.md",
            "**/*.rules",
            "**/*.mjs",
            "**/*.py",
            "*.sh",
            "*.command",
            "package.json",
            "package-lock.json",
            "seed-reviews.html",
            "gallery_items.html",
            "verify_deploy.txt",
            "test-db.mjs",
            "firestore.indexes.json",
            "admin/costing-seed*.json",
            "admin/*_part",
            "admin/*_snippet",
            "admin/*_calendar"
        ]
    }
}
