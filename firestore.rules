rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Customers Collection
    // Public: Can create/update their own customer record (blind write via setDoc)
    // Admin: Can read all, write all
    match /customers/{customerId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if true; 
      allow update: if true;
      allow delete: if request.auth != null;
    }
    
    // Requests Collection
    // Public: Can create new requests
    // Admin: Can read list, view details, update status (drag-and-drop), delete
    match /requests/{requestId} {
      allow read, write: if request.auth != null;
      allow create: if true;
      allow update: if true; // Required for Step 2 of public order form
    }

    // Gallery Items - Public read, Admin write
    match /gallery_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery Categories - Public read, Admin write
    match /gallery_categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
